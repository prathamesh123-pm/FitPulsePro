rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPermittedUser(userId) {
      return isOwner(userId) ||
             userId == 'guest' ||
             userId == 'default-athlete' ||
             userId == 'user_local' ||
             userId == 'usr-admin-01' ||
             userId.matches('^vault_.*') ||
             userId.matches('^guest_.*');
    }

    function isPermittedGuest(userId) {
      return isPermittedUser(userId);
    }

    // User profile document and isolated subcollections under users/{userId}
    match /users/{userId} {
      allow read, write: if isPermittedUser(userId);

      // Cloud Firestore collections as requested:
      // profile, products, stock, sales, customers, suppliers, purchase, orders, reports, settings, expenses, income, notifications, backup
      match /profile/{docId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /products/{productId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /stock/{stockId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /sales/{saleId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /customers/{customerId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /suppliers/{supplierId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /purchase/{purchaseId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /orders/{orderId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /reports/{reportId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /settings/{settingId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /expenses/{expenseId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /income/{incomeId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /notifications/{notificationId} {
        allow read, write: if isPermittedUser(userId);
      }
      match /backup/{backupId} {
        allow read, write: if isPermittedUser(userId);
      }

      // Recursive fallback for any nested subcollections under user's UID
      match /{allSubcollections=**} {
        allow read, write: if isPermittedUser(userId);
      }
    }

    // System-wide read/write collections
    match /rateCharts/{chartId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    match /allUsers/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01') || request.auth.uid == userId;
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated() || isPermittedGuest('usr-admin-01');
      allow create: if true;
    }

    // Core System Collections: Products, Exercises, Diet Plans, Meals, Calories, Reports, Progress, Settings
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    match /dietPlans/{planId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    match /meals/{mealId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    match /calories/{calorieId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    match /reports/{reportId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    match /progress/{progressId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated() || isPermittedGuest('usr-admin-01');
    }

    // Health check & ping tests
    match /test/{docId} {
      allow read, write: if true;
    }

    match /_connection_test_/{docId} {
      allow read, write: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
