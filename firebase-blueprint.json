{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personal fitness metrics and emergency contacts",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "mobileNumber": { "type": "string" },
        "fitnessGoal": { "type": "string" },
        "currentWeightKg": { "type": "number" },
        "goalWeightKg": { "type": "number" },
        "heightCm": { "type": "number" }
      },
      "required": ["fullName", "email"]
    },
    "FitnessData": {
      "title": "FitnessData",
      "description": "Complete user fitness state including workouts, nutrition, checklists, attendance, and achievements",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "appState": { "type": "object" }
      },
      "required": ["userId", "lastUpdated"]
    },
    "CustomFoodItem": {
      "title": "CustomFoodItem",
      "description": "User's personal food database entry with complete nutritional breakdown",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "mealType": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "fiber": { "type": "number" },
        "sugar": { "type": "number" },
        "notes": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "lastUsed": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "calories", "protein", "carbs", "fat"]
    },
    "SubmittedDailyReport": {
      "title": "SubmittedDailyReport",
      "description": "Locked daily fitness compliance submission certified by the user",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "submittedAt": { "type": "string" },
        "locked": { "type": "boolean" },
        "notes": { "type": "string" },
        "caloriesConsumed": { "type": "number" },
        "caloriesBurned": { "type": "number" },
        "waterIntakeMl": { "type": "number" },
        "totalSteps": { "type": "number" },
        "healthScore": { "type": "number" }
      },
      "required": ["date", "submittedAt", "locked"]
    },
    "SubmittedMonthlyReport": {
      "title": "SubmittedMonthlyReport",
      "description": "Monthly verified 31-day fitness audit locked by the user",
      "type": "object",
      "properties": {
        "yearMonth": { "type": "string" },
        "submittedAt": { "type": "string" },
        "locked": { "type": "boolean" },
        "monthName": { "type": "string" },
        "year": { "type": "number" },
        "overallConsistencyPct": { "type": "number" },
        "monthlyScore": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["yearMonth", "submittedAt", "locked"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User document storing fitness account profile"
    },
    "/users/{userId}/fitnessData/{docId}": {
      "schema": "FitnessData",
      "description": "User fitness synchronization document storing all workouts, nutrition logs, attendance and reports"
    },
    "/users/{userId}/customFoods/{foodId}": {
      "schema": "CustomFoodItem",
      "description": "User's individual custom food library items persisted in Firestore"
    },
    "/users/{userId}/dailyReports/{date}": {
      "schema": "FitnessData",
      "description": "Daily calculated fitness summary snapshot"
    },
    "/users/{userId}/monthlyReports/{yearMonth}": {
      "schema": "FitnessData",
      "description": "Monthly calculated fitness summary snapshot"
    },
    "/users/{userId}/submittedDailyReports/{date}": {
      "schema": "SubmittedDailyReport",
      "description": "Certified and locked daily submission audit"
    },
    "/users/{userId}/submittedMonthlyReports/{yearMonth}": {
      "schema": "SubmittedMonthlyReport",
      "description": "Certified and locked monthly submission audit"
    }
  }
}
