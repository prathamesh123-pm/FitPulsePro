{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personal fitness metrics and emergency contacts",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "mobileNumber": { "type": "string" },
        "fitnessGoal": { "type": "string" },
        "currentWeightKg": { "type": "number" },
        "goalWeightKg": { "type": "number" },
        "heightCm": { "type": "number" }
      },
      "required": ["fullName", "email"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Enterprise user credentials, role-based access level (Admin, Manager, Staff), and account metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Manager", "Staff"] },
        "department": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "LoginHistory": {
      "title": "LoginHistory",
      "description": "User login session history records with device, IP, location, and authentication method",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "timestamp": { "type": "string" },
        "device": { "type": "string" },
        "ipAddress": { "type": "string" },
        "location": { "type": "string" },
        "method": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "timestamp", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Enterprise activity log tracking CRUD operations, approvals, sync, GPS, and security changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "description": { "type": "string" },
        "device": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "timestamp", "userId", "action", "module"]
    },
    "RateChart": {
      "title": "RateChart",
      "description": "Enterprise fitness & gym service rate charts, personal training rates, and nutrition pricing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "version": { "type": "string" },
        "currency": { "type": "string" },
        "items": { "type": "array" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "version", "items"]
    },
    "FormSubmission": {
      "title": "FormSubmission",
      "description": "Dynamic forms for client intake, PAR-Q, compliance audits, and evaluation reviews with auto-save drafts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "formType": { "type": "string" },
        "title": { "type": "string" },
        "userId": { "type": "string" },
        "userRole": { "type": "string" },
        "fields": { "type": "array" },
        "status": { "type": "string" },
        "isDraft": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "formType", "title", "userId", "status"]
    },
    "GroupReport": {
      "title": "GroupReport",
      "description": "Batch cohort progress reports with multi-athlete metrics, approvals, Word/PDF exports, and auto-save",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "cohortName": { "type": "string" },
        "reportPeriod": { "type": "string" },
        "members": { "type": "array" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "cohortName", "status"]
    },
    "ActivityRecord": {
      "title": "ActivityRecord",
      "description": "User exercise and workout session activity log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "caloriesBurned": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "title", "type"]
    },
    "FitnessData": {
      "title": "FitnessData",
      "description": "Complete user fitness state including workouts, nutrition, checklists, attendance, and achievements",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "appState": { "type": "object" }
      },
      "required": ["userId", "lastUpdated"]
    },
    "Product": {
      "title": "Product",
      "description": "Gym & Diet inventory products with pricing, stock, barcode, and categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "stock": { "type": "number" },
        "barcode": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "price", "stock"]
    },
    "Exercise": {
      "title": "Exercise",
      "description": "Exercise database with video, image, sets, reps, rest time, and target muscles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "targetMuscle": { "type": "string" },
        "instructions": { "type": "string" },
        "sets": { "type": "number" },
        "reps": { "type": "number" }
      },
      "required": ["id", "name", "instructions"]
    },
    "CalorieLog": {
      "title": "CalorieLog",
      "description": "Daily calorie tracking records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "caloriesRequired": { "type": "number" },
        "caloriesConsumed": { "type": "number" },
        "caloriesBurned": { "type": "number" },
        "remainingCalories": { "type": "number" }
      },
      "required": ["id", "date", "caloriesRequired"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Gym store and nutrition products"
    },
    "/exercises/{exerciseId}": {
      "schema": "Exercise",
      "description": "Gym exercises database"
    },
    "/dietPlans/{planId}": {
      "schema": "DietPlan",
      "description": "Custom and generated diet plans"
    },
    "/calories/{calorieId}": {
      "schema": "CalorieLog",
      "description": "Calorie tracker daily entries"
    },
    "/progress/{progressId}": {
      "schema": "FitnessData",
      "description": "Body measurements and progress logs"
    },
    "/settings/{settingId}": {
      "schema": "FitnessData",
      "description": "Application preferences and settings"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User document storing fitness account profile"
    },
    "/users/{userId}/account/{docId}": {
      "schema": "UserAccount",
      "description": "User account credentials and role"
    },
    "/users/{userId}/activityLogs/{logId}": {
      "schema": "ActivityRecord",
      "description": "Individual exercise and workout logs"
    },
    "/users/{userId}/fitnessData/{docId}": {
      "schema": "FitnessData",
      "description": "User fitness synchronization document storing all workouts, nutrition logs, attendance and reports"
    },
    "/users/{userId}/rateCharts/{chartId}": {
      "schema": "RateChart",
      "description": "Rate charts managed by the user or enterprise"
    },
    "/users/{userId}/forms/{formId}": {
      "schema": "FormSubmission",
      "description": "Dynamic forms, submissions, and auto-saved drafts"
    },
    "/users/{userId}/groupReports/{reportId}": {
      "schema": "GroupReport",
      "description": "Group cohort progress reports"
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Individual and organizational audit logs"
    },
    "/users/{userId}/loginHistory/{historyId}": {
      "schema": "LoginHistory",
      "description": "User login session history records"
    }
  }
}
